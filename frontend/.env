# 应用展示名称
# 用于浏览器标题、系统名称展示等场景。
VITE_APP_TITLE = '云枢 Axis · MES'

# Vite 开发服务器端口
# 仅在本地开发服务启动时生效。
VITE_PORT = 3000

# 应用公共基础路径
# 对应 Vite 的 base 配置，适用于静态资源路径和子目录部署。
# 根路径部署使用 `/`，子目录部署可填写 `/admin/`。
VITE_PUBLIC_PATH = '/'

# 接口统一前缀
# 用于拼接接口请求路径，并与开发代理前缀保持一致。
VITE_API_PREFIX = '/api'

# 直连接口基础地址
# 开发代理启用时可留空；关闭代理或生产直连时可填写完整接口域名。
# 示例：`https://api.example.com`
VITE_API_BASE_URL = ''

# 是否启用 Vite 开发代理
# true 表示接口请求通过 Vite 开发服务器转发；false 表示前端直接请求接口地址。
VITE_USE_PROXY = 'true'

# 是否开启构建产物分析
# 设置为 true 时，生产构建会输出 `dist/stats.html`。
VITE_ANALYZE = 'false'

# SM2 加密公钥（HEX，未压缩点，含 04 前缀）
# 与后端 appsettings.json -> System.PublicKey 保持一致；用于登录密码客户端 SM2 加密。
# 留空时前端将以明文发送密码，仅在测试且后端同步未配置 SM2 私钥时可用。
VITE_SM2_PUBLIC_KEY = '04F8E6ED53D420ED611C84D6C7E27B5F0DB07B899945E695A188E613C96F2CC803127FDBC3A39DFB06822EE71E87BC43598A4DD7B2B9DCF8193B2D14236EC647DF'
