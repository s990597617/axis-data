# 应用公共基础路径
# 根路径部署使用 `/`，子目录部署可填写 `/admin/`。
VITE_PUBLIC_PATH = '/'

# 接口统一前缀
# 开发代理会监听此前缀并转发到 VITE_PROXY_TARGET。
VITE_API_PREFIX = '/api'

# 直连接口基础地址
# 开发代理启用时保持为空即可。
VITE_API_BASE_URL = ''

# 是否启用 Vite 开发代理
# 本地开发默认启用，便于规避浏览器跨域限制。
VITE_USE_PROXY = 'true'

# Vite 开发代理目标地址
# 本地接口请求会被转发到该后端服务。
VITE_PROXY_TARGET = 'http://localhost:5077'

# 是否开启构建产物分析
# 开发环境通常保持关闭。
VITE_ANALYZE = 'false'
