# 应用公共基础路径
# 如果生产环境部署在子目录，请改为对应路径，例如 `/admin/`。
VITE_PUBLIC_PATH = '/'

# 接口统一前缀
# 同源部署时通常保持 `/api`，由 Nginx 或网关转发到后端服务。
VITE_API_PREFIX = '/api'

# 直连接口基础地址
# 留空时默认使用当前站点同源地址并拼接接口前缀。
VITE_API_BASE_URL = ''

# 是否启用 Vite 开发代理
# 生产环境不会使用 Vite 开发服务器，通常保持 false。
VITE_USE_PROXY = 'false'

# Vite 开发代理目标地址
# 仅为保持环境变量类型一致而保留；VITE_USE_PROXY 为 false 时不会生效。
VITE_PROXY_TARGET = ''

# 是否开启构建产物分析
# 需要分析包体积时可临时改为 true，或使用 `ANALYZE=true pnpm build`。
VITE_ANALYZE = 'false'
