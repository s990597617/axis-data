    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>axis</ToolCommandName>
    <PackageId>Axis.Scaffold</PackageId>
    <Version>1.2.0</Version>
    <Description>云枢 Axis 模块脚手架 CLI</Description>
